# API Key Authentication
# Generate a secure API key (32+ characters, mix of letters, numbers, symbols)
# This key will be shared with your team members for authentication
API_KEY=your_secure_api_key_here

# Google Gemini API Key (required for AI processing)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Integration (optional, for CRM functionality)
GOOGLE_SPREADSHEET_ID=your_google_sheets_id_here

# Data File Path (optional, defaults to DataFile_students_OPTIMIZED.xlsx)
DATA_FILE=DataFile_students_OPTIMIZED.xlsx

# Frontend Origin (optional, for CORS in production)
# FRONTEND_ORIGIN=https://your-frontend-domain.com
